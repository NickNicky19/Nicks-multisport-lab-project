  "verification_program": "from pathlib import Path\nimport hashlib,json,sys\nroot=Path.cwd().resolve()\nsys.path.insert(0,str(root))\ndef guard(event,args):\n if event == \"open\" and args and isinstance(args[0], (str,bytes)):\n  text=args[0].decode() if isinstance(args[0],bytes) else args[0]\n  if text.startswith(\"/tmp/nml-nba-audit/\") or text.startswith(\"/workspace/Nicks-multisport-lab-project/\"):\n   raise RuntimeError(\"Recovery attempted to read external integration/raw-data path\")\nsys.addaudithook(guard)\nfrom multisport_lab import ledger\nfrom multisport_lab.record_reference import recover_summary,record_examples\nfrom multisport_lab.integrity import digest\nassert Path(ledger.__file__).resolve().is_relative_to(root)\nassert not (root/\".local-data\").exists()\nmissing=root/\"no-retained-raw-panel.jsonl\"\nassert not missing.exists()\nfiles=sorted((root/\"records\").glob(\"*/*.json\"))\nbefore={p.relative_to(root).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in files}\nsummary=recover_summary(root,root/\"evidence/research/reference-publication-002.json\")\nstore=ledger.Ledger(root);index=store.scan()\nrecovered=record_examples(root,missing,\"900a7df5ed5270ec6e32054cfa7e6bb2bf29dec7\")\nassert recovered == summary\nclocks=[]\nfor example in summary[\"examples\"]:\n for name in (\"forecast\",\"outcome\",\"grade\"):\n  ref=ledger.LedgerRef.from_record(example[name+\"_ref\"]);payload=store.read(ref)\n  body=payload[\"data\"][{\"forecast\":\"bundle\",\"outcome\":\"outcome\",\"grade\":\"grade\"}[name]]\n  clock={\"forecast\":\"issued_at\",\"outcome\":\"observed_at\",\"grade\":\"graded_at\"}[name]\n  clocks.append({\"kind\":name,\"record_id\":ref.record_id,\"payload_sha256\":ref.payload_sha256,\"received_at\":payload[\"received_at\"],clock:body[clock]})\nassert before == {p.relative_to(root).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in files}\nprint(json.dumps({\"module_loaded_from_clone\":str(Path(ledger.__file__).resolve()),\"raw_panel_present\":False,\"local_data_directory_present\":False,\"external_integration_and_raw_data_reads_guarded\":True,\"fresh_process_record_counts\":{k:len(v) for k,v in index.items()},\"summary_recovered_with_missing_input\":True,\"summary_payload_sha256\":digest(summary),\"all18_file_bytes_unchanged\":True,\"original_clocks\":clocks},sort_keys=True))\n",
