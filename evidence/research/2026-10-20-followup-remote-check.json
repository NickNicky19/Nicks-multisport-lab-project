  "fresh_process_program": "from datetime import datetime,timezone\nfrom pathlib import Path\nimport hashlib,json,os,sys\nrepo=Path(sys.argv[1]).resolve()\nblocked_roots=(Path('/workspace/Nicks-multisport-lab-project'),Path('/tmp/nml-nba-audit'))\nblocked_attempts=[]\ndef guard(event,args):\n    if event=='open' and args and isinstance(args[0],(str,bytes,os.PathLike)):\n        path=Path(os.fsdecode(args[0])).absolute()\n        if any(path==root or root in path.parents for root in blocked_roots):\n            blocked_attempts.append(str(path))\n            raise PermissionError('verification process cannot read integration or raw inputs')\nsys.addaudithook(guard)\nsys.path.insert(0,str(repo))\nfrom multisport_lab import baseline,research_pilot,record_reference,ledger\nfrom multisport_lab.development_003 import implementation_hashes,validate_protocol\nfrom multisport_lab.integrity import read_receipt,digest,utc\nassert Path(ledger.__file__).resolve()==repo/'multisport_lab/ledger.py'\ndef forbidden(*args,**kwargs):\n    raise AssertionError('forecast generation/raw panel import forbidden during readback')\nbaseline.forecast_reference=forbidden\nresearch_pilot.forecast_reference=forbidden\nresearch_pilot.read_normalized_panel=forbidden\nrecord_reference.forecast_reference=forbidden\nrecord_reference.read_normalized_panel=forbidden\n# Prove the read guard is active without inspecting either target file.\nfor root in blocked_roots:\n    try:\n        (root/'guard-probe-never-read').open('rb')\n    except PermissionError:\n        pass\n    else:\n        raise AssertionError('read guard failed')\nfiles=sorted(repo.glob('records/*/*.json'))\nbefore={str(path.relative_to(repo)):hashlib.sha256(path.read_bytes()).hexdigest() for path in files}\nassert len(before)==18\nstore=ledger.Ledger(repo)\nscan=store.scan()\ncounts={kind:len(records) for kind,records in scan.items()}\nassert counts=={'forecasts':6,'outcomes':6,'grades':6,'input_captures':0,'corrections':0}\nsummary_path=repo/record_reference.SUMMARY_PATH\nsummary_bytes=summary_path.read_bytes()\nsummary=record_reference.recover_summary(repo,summary_path)\nassert summary['schema_version']=='reference-publication-002-v1'\nassert len(summary['examples'])==6 and summary['genuine_future_issuances']==0\nassert summary['recorded_at']=='2026-10-20T00:21:49.746072Z'\nassert not (repo/'absent-normalized.jsonl').exists() and not (repo/'.local-data').exists()\nassert record_reference.record_examples(repo,repo/'absent-normalized.jsonl','unused-during-recovery')==summary\nassert summary_path.read_bytes()==summary_bytes\nassert len(list(store.iter_active_forecasts()))==6\nassert len(list(store.iter_active_grades()))==6\nclocks=[]\nfor kind in ('forecasts','outcomes','grades'):\n    name={'forecasts':'bundle','outcomes':'outcome','grades':'grade'}[kind]\n    for identity,payload in sorted(scan[kind].items()):\n        body=payload['data'][name]\n        assert body.get('evidence_lane','RECONSTRUCTED_RESEARCH')=='RECONSTRUCTED_RESEARCH'\n        if kind=='forecasts': assert len(body['categories'])==14 and body['qualification']=='UNAVAILABLE'\n        if kind=='grades': assert len(body['categories'])==14 and body['financial_settlement']=='NOT_EVALUATED'\n        clocks.append({'kind':kind,'record_id':identity,'received_at':payload['received_at'],\n            **{key:body[key] for key in ('event_id','player_id','event_starts_at','cutoff_at','history_freeze','trained_through','issued_at','observed_at','graded_at') if key in body}})\nprotocol=read_receipt(repo/'evidence/research/dev003-protocol.json',max_bytes=8*1024*1024)\ninventory=read_receipt(repo/'evidence/research/dev003-inventory.json',max_bytes=8*1024*1024)\nresult=read_receipt(repo/'evidence/research/dev003-results.json',max_bytes=8*1024*1024)\nvalidate_protocol(protocol,inventory['inventory'])\nassert result['inventory']==protocol['inventory']==inventory['inventory']\nassert result['protocol_payload_sha256']==digest(protocol)=='06600825f5c64f396315c29251516da72133f659efca6e3f72a7a2ab7c3322db'\nassert digest(result)=='e02454af951c9af4efb3491a23329e1d78574805e7b2f108172205ed850b3fb7'\nassert result['implementation_source_sha256']==protocol['implementation_source_sha256']==implementation_hashes()\nassert result['scored_appearances_per_model']==517 and result['post_score_exclusions']==0\nassert result['K0_fallback_counts']=={'KERNEL_PRIOR':508,'N0_EXACT_R0':9}\nassert result['repository_head_at_execution']=='2b58ac45c7ec29fa0cba2c41facd3862c137a961'\nassert utc(protocol['recorded_at'])<utc(result['run_started_at'])<utc(result['run_finished_at'])\nfor model in result['models'].values():\n    assert len(model['categories'])==14 and all(c['scored_count']==517 for c in model['categories'].values())\ntiming=json.loads((repo/'evidence/data/2026-10-20-future-history-timing.json').read_bytes())\ndiscovery=json.loads((repo/'evidence/data/2026-10-20-pregame-discovery.json').read_bytes())\nassert timing['full_panel_import_eligible_rows']==26645 and len(timing['events'])==3\nassert timing['status']=='REPORTED_CLOCK_CONSISTENCY_PASS' and timing['future_issuance_admitted'] is False\nassert timing['pregame_discovery_sha256']==hashlib.sha256((repo/'evidence/data/2026-10-20-pregame-discovery.json').read_bytes()).hexdigest()\nassert discovery['event_count']==3\nassert before=={str(path.relative_to(repo)):hashlib.sha256(path.read_bytes()).hexdigest() for path in files}\nassert len(blocked_attempts)==2\nprint(json.dumps({'checked_at':datetime.now(timezone.utc).isoformat(timespec='microseconds').replace('+00:00','Z'),\n    'module_loaded_from_clone':str(Path(ledger.__file__).resolve()),'fresh_process_record_counts':counts,\n    'record_file_count':18,'record_bytes_total':sum(path.stat().st_size for path in files),\n    'recovered_summary_schema':summary['schema_version'],'recovered_summary_recorded_at':summary['recorded_at'],\n    'recovered_summary_examples':len(summary['examples']),'summary_bytes_preserved':True,\n    'all1